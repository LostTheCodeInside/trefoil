<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules).

  android:allowBackup="false" already stops cloud backup on every version, but it
  does not by itself stop a device-to-device transfer on 12 and above. Both sections
  are therefore excluded explicitly, so profiles.json cannot leave the device by
  either route.

  What is at stake: profiles.json holds every server's credentials in plain text
  (WireGuard private keys, VLESS/VMess UUIDs, Trojan and Shadowsocks passwords). A
  restore onto a phone that is not this one hands all of them over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
